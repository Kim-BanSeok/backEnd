PORT=3000
NODE_ENV=development
# 로컬 PostgreSQL (테스트는 DB_DATABASE 뒤에 _test 를 붙인 DB 를 자동으로 쓴다. 바꾸려면 DB_DATABASE_TEST)
DB_ID=postgres
DB_PASS=
DB_DATABASE=material_loop
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres
# 사진 저장소 (지금은 내 컴퓨터 폴더만 지원). PUBLIC_URL 은 응답에 들어가는 사진 주소의 앞부분이다.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:3000
# API 문서(Swagger, /api-docs). 개발에서는 기본으로 켜지고 운영(NODE_ENV=production)에서는 기본으로 꺼진다.
DOCS_ENABLED=true
# 처음 한 번 만드는 운영팀(ADMIN) 계정. npm run db:seed 가 만들고, 이미 있으면 다시 만들지 않는다. (비밀번호 8~72자)
# 가입 API 로는 ADMIN 을 만들 수 없다. 비밀번호는 직접 정해서 .env 에만 적는다. (Git 에 올리지 않는다)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NICKNAME=운영팀
# AI 보조 등록. fake 는 키 없이 쓰는 개발용 규칙(운영에서는 사용 불가), 운영은 AI_PROVIDER=claude 와 ANTHROPIC_API_KEY 가 필요하다.
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=15000
AI_SESSION_STORE=memory
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173
