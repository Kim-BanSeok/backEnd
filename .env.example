PORT=3000
NODE_ENV=development
# 로컬 PostgreSQL (테스트는 DB_DATABASE 뒤에 _test 를 붙인 DB 를 자동으로 쓴다. 바꾸려면 DB_DATABASE_TEST)
DB_ID=postgres
DB_PASS=
DB_DATABASE=material_loop
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173
