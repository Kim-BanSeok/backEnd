PORT=3000
NODE_ENV=development
# 모든 API와 사진 조회를 IP별 합산. 가입·로그인/AI의 추가 한도는 별도로 유지한다.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=300
# 실제 역방향 프록시의 IP/CIDR만 쉼표로 지정. 비우면 전달 헤더를 신뢰하지 않는다.
# true·프록시 홉 수·/0은 허용하지 않는다. 예: 127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
# 로컬 PostgreSQL (테스트는 DB_DATABASE 뒤에 _test 를 붙인 DB 를 자동으로 쓴다. 바꾸려면 DB_DATABASE_TEST)
DB_ID=postgres
DB_PASS=
DB_DATABASE=material_loop
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# 사진 저장소 (지금은 내 컴퓨터 폴더만 지원). PUBLIC_URL 은 응답에 들어가는 사진 주소의 앞부분이다.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:3000
# API 문서(Swagger, /api-docs). 개발에서는 기본으로 켜지고 운영(NODE_ENV=production)에서는 기본으로 꺼진다.
DOCS_ENABLED=true
# 처음 한 번 만드는 운영팀(ADMIN) 계정. npm run db:seed 가 만들고, 이미 있으면 다시 만들지 않는다. (비밀번호 8자 이상, UTF-8 72바이트 이하)
# 가입 API 로는 ADMIN 을 만들 수 없다. 비밀번호는 직접 정해서 .env 에만 적는다. (Git 에 올리지 않는다)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NICKNAME=운영팀
# AI 보조 등록. fake 는 키 없이 쓰는 개발용 규칙(운영에서는 사용 불가).
# 지금은 openai 와 OPENAI_API_KEY. 나중에 claude 와 ANTHROPIC_API_KEY 로 바꾼다.
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=15000
AI_SESSION_STORE=database
# 운영은 database만 허용. 진행 중·중단 세션 24시간, 확정 세션의 대화·AI 초안 30일 보관.
# 계정별/서비스 전체 한도. 재시도와 실패한 제공자 호출도 시간당 사용량에 포함된다.
AI_USER_CALLS_PER_HOUR=30
AI_GLOBAL_CALLS_PER_HOUR=300
AI_USER_CONCURRENT_CALLS=2
AI_GLOBAL_CONCURRENT_CALLS=4
AI_USER_SESSIONS_PER_HOUR=20
AI_GLOBAL_SESSIONS_PER_HOUR=200
AI_USER_ACTIVE_SESSIONS=5
AI_GLOBAL_ACTIVE_SESSIONS=100
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# 주소→좌표 배치 전용. Secret은 서버에만 설정한다. 지도 후보 계획 출력에는 키가 필요 없다.
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
