PORT=3000
NODE_ENV=development
# 로컬 PostgreSQL (테스트는 DB_DATABASE 뒤에 _test 를 붙인 DB 를 자동으로 쓴다. 바꾸려면 DB_DATABASE_TEST)
DB_ID=postgres
DB_PASS=
DB_DATABASE=material_loop
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres
# 사진 저장소 (지금은 내 컴퓨터 폴더만 지원). PUBLIC_URL 은 응답에 들어가는 사진 주소의 앞부분이다.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:3000
# API 문서(Swagger, /api-docs). 개발에서는 기본으로 켜지고 운영(NODE_ENV=production)에서는 기본으로 꺼진다.
DOCS_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173
