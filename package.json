{
  "name": "gongmojen",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "test": "node --env-file=.env --import ./tests/setup.js --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize db:migrate",
    "migrate:undo": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "migrate:status": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize db:migrate:status",
    "db:ensure": "node --env-file=.env scripts/ensure-database.js",
    "migrate:test": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize db:migrate --env test",
    "db:ensure:test": "node --env-file=.env scripts/ensure-database.js --test",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "sequelize-cli": "^6.6.5"
  }
}
