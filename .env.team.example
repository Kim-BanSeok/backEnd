# 로컬 백엔드에서 기존 팀 개발 DB에 연결할 때만 사용하는 예시.
# .env.team 으로 복사하고 실제 팀 DB 값으로 바꾼다. 실제 파일은 Git 제외.
# 팀 DB 주소·계정·TLS·접속 방법은 담당자가 제공해야 한다.
NODE_ENV=development
PORT=3000
DB_HOST=TEAM_POSTGRES_HOST
DB_PORT=5432
DB_DATABASE=TEAM_DEVELOPMENT_DATABASE
DB_ID=TEAM_APP_USER
DB_PASS=
DB_DIALECT=postgres
JWT_SECRET=
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
PUBLIC_URL=http://127.0.0.1:3000
DOCS_ENABLED=true
AI_PROVIDER=fake
AI_SESSION_STORE=memory
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
# 이 파일로 npm test 또는 migrate:test를 실행하지 않는다.
# 공용 DB에는 자동 테스트를 실행하지 않고 개인 전용 로컬 테스트 환경을 사용한다.
